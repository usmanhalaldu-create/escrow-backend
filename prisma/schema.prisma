generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(uuid())
  description String?
  amount      Float
  buyer       String
  seller      String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}
